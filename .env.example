# ===================================
# Terraria Server Configuration
# ===================================

# S3 Configuration
AWS_REGION=ap-northeast-1
S3_BUCKET=kishax-production-terraria-backups
S3_DOWNLOAD_ENABLED=false

# TShock Server Configuration
SERVER_PASSWORD=<your-server-password>
SERVER_PORT=7777
MAX_SLOTS=8
SERVER_NAME=Kishax Terraria Server

# Discord Bot Configuration (TerrariaChatRelay)
# Get bot token from: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=<your-discord-bot-token>
# Get channel ID by enabling Developer Mode in Discord, right-click channel -> Copy ID
DISCORD_CHANNEL_ID=<your-discord-channel-id>
# Discord presence activity (bot status)
DISCORD_PRESENCE_ACTIVITY=tera.kishax.net

# TShock REST API Configuration
# REST API allows external applications to control the server
REST_API_ENABLED=true
REST_API_PORT=7878
# Generate a random token for security: openssl rand -base64 32
REST_API_TOKEN=<generate-random-token>
REST_API_USERNAME=admin
REST_API_USERGROUP=superadmin

# ===================================
# Usage Notes
# ===================================
#
# 1. S3 Bucket Structure:
#    s3://kishax-production-terraria-backups/
#      ├── deployment/
#      │   └── YYYYMM/
#      │       └── VERSION/
#      │           └── terraria/
#      │               ├── Worlds/
#      │               └── tshock/
#      │                   └── tshock.sqlite
#
# 2. Discord Bot Setup:
#    - Create bot at https://discord.com/developers/applications
#    - Enable "Message Content Intent" in Bot settings
#    - Invite bot to your server with appropriate permissions
#    - Copy bot token and channel ID to this file
#
# 3. Security Notes:
#    - Keep REST_API_TOKEN secret
#    - Use strong SERVER_PASSWORD
#    - Rotate credentials periodically
